{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pantrycon-assessment.schema.json",
  "title": "PANTRYCON assessment",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "instrument",
    "level",
    "reviewedAt",
    "staleAfterHours",
    "scope",
    "headline",
    "summary",
    "rationale",
    "supplyWindow",
    "disclaimer",
    "overrides",
    "evidence",
    "factors",
    "levels",
    "checklist",
    "methodology",
    "limitations",
    "sources"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "instrument": { "const": "PANTRYCON" },
    "level": { "type": "integer", "minimum": 1, "maximum": 5 },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "staleAfterHours": { "type": "number", "exclusiveMinimum": 0 },
    "scope": {
      "type": "object",
      "required": ["geography", "weighting"],
      "properties": {
        "geography": { "type": "string", "minLength": 1 },
        "weighting": { "const": "national" }
      }
    },
    "headline": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string", "minLength": 1 },
    "supplyWindow": { "type": "string", "minLength": 1 },
    "disclaimer": { "type": "string", "minLength": 1 },
    "overrides": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "factor", "title", "status", "summary"],
        "properties": {
          "id": { "type": "string" },
          "factor": { "type": "string" },
          "title": { "type": "string" },
          "status": { "enum": ["confirmed", "developing", "unverified"] },
          "summary": { "type": "string" },
          "limits": { "type": "string" },
          "source": {
            "type": "object",
            "required": ["href", "label"],
            "properties": {
              "href": { "type": "string" },
              "label": { "type": "string" }
            }
          }
        }
      }
    },
    "factors": {
      "type": "object",
      "required": ["raise", "lower"],
      "properties": {
        "raise": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "lower": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "levels": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["level", "name", "window", "means", "doesNotMean"],
        "properties": {
          "level": { "type": "integer", "minimum": 1, "maximum": 5 },
          "name": { "type": "string" },
          "window": { "type": "string" },
          "means": { "type": "string" },
          "doesNotMean": { "type": "string" }
        }
      }
    },
    "checklist": {
      "type": "object",
      "required": ["intro", "groups"],
      "properties": {
        "intro": { "type": "string" },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "title", "items"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "items": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "methodology": { "type": "string" },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["href", "label", "usedFor"],
        "properties": {
          "href": { "type": "string" },
          "label": { "type": "string" },
          "usedFor": { "type": "string" }
        }
      }
    },
    "links": {
      "type": "object",
      "properties": {
        "publicSite": { "type": "string" }
      }
    }
  }
}
